% CASE text.nfc_equivalent
% The first entry writes every accent decomposed (a letter, then U+0301,
% U+0308, U+0327 or U+0306), the second precomposed. They are canonically
% equivalent, so both are read as one text: the member resolves from either,
% each collaborator is one spelling, and `Vale, Ç.` is an initial whichever
% way its cedilla is written, so it could be `Vale, Çelik`. The decomposed
% entry comes first, so its grouping is the one reported. The third entry's
% citation key is written decomposed too, and its title puts a brace between
% `n` and U+0303, so the text is NFC as read and decomposed only once LaTeX
% drops the braces: the converted title is put in NFC as well.
%
% `Q` + U+0307 has no precomposed form, so it stays decomposed. `Wren, Q̇.`
% and `Wren, Q̇.Q̇.` are initials all the same, as `Q.` and `Q.Q.` are,
% and could be `Wren, Quade` or `Wren, Quade Quill`.

@article{nfc-decomposed,
  title   = {Décor for Fictional Robots},
  author  = {Noël, Émile and Zorn, Çağla and Vale, Ç.},
  journal = {Journal of Fictional Robots},
  year    = {2024}
}

