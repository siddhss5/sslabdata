% CASE links.scheme_unsupported
% Links whose scheme is not http, https or mailto, and links beside them whose
% scheme is. Each unsupported one is reported once, and every link is emitted.

@misc{scheme-javascript,
  title  = {A Script URL},
  author = {Adams, Alice},
  year   = {2024},
  url    = {javascript:alert(1)}
}

@misc{scheme-mixed-case,
  title  = {A Script URL in Mixed Case},
  author = {Adams, Alice},
  year   = {2024},
  url    = {JavaScript:alert(1)}
}

% The host is a video host, so the link's kind is video though its field is url.
@misc{scheme-video-host,
  title  = {A Script URL on a Video Host},
  author = {Adams, Alice},
  year   = {2024},
  url    = {javascript://youtube.com/%0aalert(1)}
}

% A host the URL parser rejects: the scheme before it is still read.
@misc{scheme-malformed-host,
  title  = {A Script URL With a Malformed Host},
  author = {Adams, Alice},
  year   = {2024},
  url    = {javascript://[x}
}

@misc{scheme-data-video,
  title  = {A Data URL as a Video},
  author = {Adams, Alice},
  year   = {2024},
  video  = {data:text/html;base64,PHNjcmlwdD4=}
}

@misc{scheme-vbscript-pdf,
  title  = {A VBScript URL as a PDF},
  author = {Adams, Alice},
  year   = {2024},
  pdf    = {vbscript:msgbox(1)}
}

% Supported schemes, in either case, and the links built from identifiers.
