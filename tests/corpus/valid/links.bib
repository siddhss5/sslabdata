% Fictional link cases for tests/COVERAGE.md. 10.5555 is a DOI test prefix.

% CASE links.doi_bare
% CASE fields.doi
% CASE output.work.identifiers
% CASE links.origin
@article{link-doi-bare,
  title   = {Bare DOI},
  author  = {Adams, Alice},
  journal = {Journal of Fictional Robots},
  year    = {2023},
  doi     = {10.5555/corpus.0001}
}

% CASE links.doi_url
@article{link-doi-url,
  title   = {DOI Given as a URL},
  author  = {Adams, Alice},
  journal = {Journal of Fictional Robots},
  year    = {2023},
  doi     = {https://doi.org/10.5555/corpus.0002}
}

% CASE links.arxiv_prefixed
% CASE fields.archiveprefix
@misc{link-arxiv-prefix,
  title         = {arXiv with archivePrefix},
  author        = {Adams, Alice},
  eprint        = {2401.00001},
  archivePrefix = {arXiv},
  year          = {2023}
}

% An eprint in a repository that is not arXiv. The scheme is whatever
% archivePrefix named, so a compiler that defaulted to arXiv would lose which
% repository the identifier belongs to -- and would also build an arXiv URL
% for an identifier that is not an arXiv one.
% CASE fields.archiveprefix
% CASE links.arxiv_other_repository
@misc{link-eprint-hal,
  title         = {A Preprint in Another Repository},
  author        = {Adams, Alice},
  eprint        = {hal-04001234},
  archivePrefix = {HAL},
  year          = {2023}
}

% CASE links.arxiv_unprefixed
@misc{link-arxiv-bare,
  title  = {arXiv without archivePrefix},
  author = {Adams, Alice},
  eprint = {2401.00002},
  year   = {2023}
}

% biblatex names the repository in eprinttype, which archivePrefix aliases.
% CASE fields.eprinttype
@misc{link-eprinttype-hal,
  title      = {A HAL Preprint Named by eprinttype},
  author     = {Adams, Alice},
  eprint     = {hal-01234567},
  eprinttype = {hal},
  year       = {2023}
}

% CASE fields.eprinttype
@misc{link-eprinttype-pubmed,
  title      = {A PubMed Record Named by eprinttype},
  author     = {Adams, Alice},
  eprint     = {12345678},
  eprinttype = {pubmed},
  year       = {2023}
}

% CASE fields.archiveprefix_latex
@misc{link-arxiv-braced,
  title         = {arXiv with a Braced archivePrefix},
  author        = {Adams, Alice},
  eprint        = {2401.00003},
  archivePrefix = {{arXiv}},
  year          = {2023}
}

% CASE links.youtube
% CASE fields.url
% CASE output.work.links
@inproceedings{link-youtube,
  title     = {A YouTube Video},
  author    = {Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2023},
  url       = {https://www.youtube.com/watch?v=corpus00001}
}

% CASE links.vimeo
@inproceedings{link-vimeo,
  title     = {A Vimeo Video},
  author    = {Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2023},
  url       = {https://vimeo.com/000000001}
}

% CASE links.url
% CASE links.origin
% CASE output.work.links
% CASE output.link.verification
@inproceedings{link-url,
  title     = {A Plain Web Link},
  author    = {Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2023},
  url       = {https://example.org/papers/link-url}
}

% pdfs/present.pdf exists for this key.
% CASE links.pdf.local_present
@inproceedings{present,
  title     = {A Paper Whose PDF Is Present},
  author    = {Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2023}
}

% There is no pdfs/missing.pdf.
% CASE links.pdf.local_missing
@inproceedings{missing,
  title     = {A Paper Whose PDF Is Missing},
  author    = {Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2023}
}

% CASE links.note_link_award
@inproceedings{link-note-award,
  title     = {A Note with a Link and an Award},
  author    = {Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2023},
  note      = {\href{https://example.org/papers/award}{Website}, Best Paper Award Finalist}
}

% A `pdf` field names the work's PDF, in place of the one pdf_base_url gives.
% CASE links.pdf_field
@inproceedings{link-pdf-field,
  title     = {A Paper That Names Its Own PDF},
  author    = {Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2023},
  pdf       = {https://example.org/papers/link-pdf-field.pdf}
}

% An empty `pdf` field is read as absent. There is no pdfs/link-pdf-empty.pdf.
% CASE links.pdf_field
@inproceedings{link-pdf-empty,
  title     = {A Paper with an Empty PDF Field},
  author    = {Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2023},
  pdf       = { }
}
