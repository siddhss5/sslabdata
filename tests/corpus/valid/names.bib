               van* den Berg, Victor and Smith, Jr.*, John and
               Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2022}
}

% The same marker written in ways that need putting back together first: twice
% over, wrapped in a brace group of its own, and with a space between
% \textsuperscript and its argument, which BibTeX splits into two name parts.
% All three come off. A brace group holding only a star is not one of them: it
% is how any other command takes its argument, so Dave Davis is not marked.
% CASE names.equal_contribution_normalized
@inproceedings{name-equal-normalized,
  title     = {Equal Contribution Written Twice, in a Brace Group, and Spaced},
  author    = {Brown$^{*}$*, Bob and Kim{$^{*}$}, Alex and
               Green\textsuperscript {*}, Grace-Ann and Davis{*}, Dave and
               Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2022}
}

% A spaced marker followed by another one, in each of the four forms: joining
% the command to its argument makes the first whole, and the rest comes off
% the same way an unspaced run of markers does.
% CASE names.equal_contribution_normalized
@inproceedings{name-equal-stacked,
  title     = {A Spaced Marker Followed by Another},
  author    = {Brown\textsuperscript {*}$^{*}$, Bob and
               Davis\textsuperscript {*}^{*}, Dave and
               Green\textsuperscript {*}\textsuperscript{*}, Grace-Ann and
               Kim\textsuperscript {*}*, Alex and Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2022}
}

% A spaced marker written twice. BibTeX splits it into three name parts, and
% reads the middle one, {*}\textsuperscript, as a lower-case word, so on a
% surname the first two parts land in the particle and the last in the
% surname. The three are joined back into one marker wherever they landed.
% Text after the second argument makes it no marker, and Erin Evans is left
% unmarked.
% CASE names.equal_contribution_doubled
@inproceedings{name-equal-doubled,
  title     = {A Spaced Marker Written Twice},
  author    = {Brown\textsuperscript {*}\textsuperscript {*}, Bob and
               Kim, Alex\textsuperscript {*}\textsuperscript {*} and
               Evans\textsuperscript {*}\textsuperscript {*}x, Erin and
               Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2022}
}

% A star, caret, dollar or backslash with a backslash in front of it is escaped
% text, not a marker: nobody is marked, and the name parts keep their own
% boundaries. What the escaped spelling itself becomes is the ordinary LaTeX
% conversion's business.
% CASE names.equal_contribution_escaped
@inproceedings{name-equal-escaped,
  title     = {Escaped Stars Are Not Markers},
  author    = {Brown\*, Bob and Davis\^{*}, Dave and Green\$^{*}$, Grace-Ann and
               Evans\\textsuperscript {*}, Erin and Adams, Alice},
  booktitle = {Proceedings of the Fictional Conference},
  year      = {2022}
}

