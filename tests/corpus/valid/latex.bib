% Fictional LaTeX and text cases for tests/COVERAGE.md.
% Titles, abstracts and notes should come out as plain Unicode text, with
% $...$ math kept as TeX for KaTeX/MathJax.

% CASE latex.textbf
% CASE output.work.title
@article{tex-textbf,
  title   = {A \textbf{Bold} Claim},
  author  = {Adams, Alice},
  journal = {Journal of Fictional Robots},
  year    = {2021}
}

